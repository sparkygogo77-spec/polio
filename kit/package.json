{
  "name": "builder-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Builder-ready starter kit: the contract, the checker and a sample site that J's Polio builder can read and edit.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "kit:check": "node tools/kit-check.mjs builder.json",
    "kit:hooks": "node tools/kit-check.mjs builder.json --write",
    "kit:diff": "node tools/kit-diff.mjs builder.json",
    "kit:new": "node tools/new-site.mjs",
    "test": "node --test test/*.test.mjs",
    "serve": "python3 -m http.server 8080",
    "kit:record-diff": "node tools/record-diff.mjs",
    "kit:states": "node tools/state-frames.mjs",
    "kit:part": "node tools/add-part.mjs"
  }
}
